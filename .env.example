# Kalshi API credentials
# Generate at: https://kalshi.com/settings/api
KALSHI_API_KEY=your-api-key-uuid-here

# For Vercel (or any environment without a local file):
# Paste the full PEM contents as a single env var (Vercel dashboard supports multiline).
KALSHI_PRIVATE_KEY_CONTENT=

# For local development only — path to the PEM file on disk.
# Ignored when KALSHI_PRIVATE_KEY_CONTENT is set.
KALSHI_PRIVATE_KEY_PATH=kalshi_private.pem

# Optional overrides
LOG_LEVEL=INFO
